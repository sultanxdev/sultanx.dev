        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n%% CLIENT\n\nsubgraph CLIENT[\&quot;CUSTOMER APPLICATION\&quot;]\n    APP[Express / Fastify API]\n    SDK[Sendry SDK Middleware]\n    APP --&gt; SDK\nend\n\n%% INGESTION\n\nsubgraph INGESTION[\&quot;INGESTION LAYER\&quot;]\n    API[Telemetry Ingestion API]\n    AUTH[API Key Validation]\n    API --&gt; AUTH\nend\n\n%% MESSAGING\n\nsubgraph MQ[\&quot;MESSAGE BROKER\&quot;]\n    RABBIT[(RabbitMQ)]\nend\n\n%% PROCESSING\n\nsubgraph PROCESSING[\&quot;EVENT PROCESSING ENGINE\&quot;]\n    CONSUMER[Background Consumer]\n    IDEMPOTENCY[Idempotency Guard]\n    CB[Circuit Breaker]\n    RETRY[Retry Engine]\n    DLQ[(Dead Letter Queue)]\n\n    CONSUMER --&gt; IDEMPOTENCY\n    IDEMPOTENCY --&gt; CB\n    CB --&gt; RETRY\n\n    RETRY -. Failed Events .-&gt; DLQ\nend\n\n%% STORAGE\n\nsubgraph STORAGE[\&quot;DATA LAYER\&quot;]\n    MONGO[(MongoDB&lt;br/&gt;Raw Telemetry)]\n    PG[(PostgreSQL&lt;br/&gt;Aggregated Metrics)]\nend\n\n%% ANALYTICS\n\nsubgraph ANALYTICS[\&quot;ANALYTICS API\&quot;]\n    SERVICE[Analytics Service]\nend\n\n%% DASHBOARD\n\nsubgraph DASHBOARD[\&quot;CUSTOMER DASHBOARD\&quot;]\n    REACT[React Dashboard]\n\n    LATENCY[Latency Analytics]\n    ERRORS[Error Monitoring]\n    ENDPOINTS[Endpoint Insights]\n\n    REACT --&gt; LATENCY\n    REACT --&gt; ERRORS\n    REACT --&gt; ENDPOINTS\nend\n\n%% FLOW\n\nSDK --&gt; API\n\nAUTH --&gt; RABBIT\n\nRABBIT --&gt; CONSUMER\n\nRETRY --&gt; MONGO\nRETRY --&gt; PG\n\nMONGO --&gt; SERVICE\nPG --&gt; SERVICE\n\nSERVICE --&gt; REACT&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2cg2YWLHQ0M3M6fPRVW5-324">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;fontSize=18;fontStyle=1" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
