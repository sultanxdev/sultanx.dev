        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n\nparticipant App as Customer API\nparticipant SDK as Sendry SDK\nparticipant API as Sendry API\nparticipant MQ as RabbitMQ\nparticipant Consumer as Consumer\nparticipant Mongo as MongoDB\nparticipant PG as PostgreSQL\nparticipant Dashboard as Dashboard\n\nApp-&gt;&gt;SDK: Request Completes\n\nSDK-&gt;&gt;API: POST Telemetry Event\n\nAPI-&gt;&gt;API: Validate API Key\n\nAPI-&gt;&gt;MQ: Publish Event\n\nAPI--&gt;&gt;SDK: 202 Accepted (&lt;2ms)\n\nMQ-&gt;&gt;Consumer: Deliver Event\n\n\nConsumer-&gt;&gt;Mongo: Store Raw Event\n\nConsumer-&gt;&gt;PG: UPSERT Aggregated Metrics\n\nDashboard-&gt;&gt;API: Fetch Analytics\n\nAPI-&gt;&gt;PG: Query Metrics\n\nPG--&gt;&gt;API: Aggregated Results\n\nAPI--&gt;&gt;Dashboard: Analytics Response&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2cg2YWLHQ0M3M6fPRVW5-91">
